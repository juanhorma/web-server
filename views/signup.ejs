<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <%- include('partials/header') %>
    <main>
      <h2 class="text-lg font-bold mb-4">Sign up</h2>
      <form method="POST" action="/signup" class="flex flex-col gap-3 max-w-sm">
        <% if (error) { %>
          <p id="form-error" role="alert" class="text-red-700"><%= error %></p>
        <% } %>
        <label for="signup-email" class="flex flex-col gap-1">Email
          <input type="email" id="signup-email" name="email" value="<%= email %>" autocomplete="email" required class="form-input">
        </label>
        <label for="signup-password" class="flex flex-col gap-1">Password
          <input type="password" id="signup-password" name="password" autocomplete="new-password" required class="form-input">
        </label>
        <button type="submit" id="signup-submit" class="bg-teal-700 text-white rounded px-4 py-2 hover:bg-teal-800">Sign up</button>
      </form>
      <p class="mt-4">Already have an account? <a href="/login" class="text-teal-700 underline">Log in</a>.</p>
    </main>
  </body>
</html>

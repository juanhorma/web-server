<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/style.css">
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  </head>
  <body>
    <%- include('partials/header.ejs') %>
    <form id="entry-form">
      <input type="text" name="title" placeholder="Title">
      <input type="text" name="body" placeholder="Body">
      <button type="submit">Add entry</button>
    </form>
    <p id="form-error"></p>
    <ul id="entries">
      <% entries.forEach(entry => { %>
        <% const id = entry.id%>
        <li data-id="<%= id %>" data-title="<%= entry.title %>" data-body="<%= entry.body %>">
            <span class="entry-display"><strong><%= entry.title %>:</strong> <%=entry.body %></span>
            <button class="favorite-btn" type="button">★</button>
            <button class="edit-btn" type="button">Edit</button>
            <button
              class="delete-btn"
              hx-delete="/entries/<%=id%>"
              hx-request='{"timeout": 2000}'
              hx-target="closest li"
              hx-swap="outerHTML"
              hx-disabled-elt="this"
              hx-indicator="#deletion"
            >
            Delete
            </button>
            <span id="indicator" class="htmx-indicator">Deleting...</span>
        </li>
      <% }); %>
    </ul>

    <section class="classic-form">
      <h2>Classic form (no JavaScript)</h2>
      <form method="POST" action="/entries/classic">
        <input type="text" name="title" placeholder="Title">
        <input type="text" name="body" placeholder="Body">
        <button type="submit">Add entry the classic way</button>
      </form>
    </section>

    <script src="/app.js" defer></script>

  </body>

</html>

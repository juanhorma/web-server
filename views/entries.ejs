<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
    <meta
      name="htmx-config"
      content='{
        "timeout": 5000,
        "responseHandling": [
          { "code": "204", "swap": false },
          { "code": "[23]..", "swap": true },
          { "code": "[45]..", "swap": true, "error": true, "target": "#status", "swapOverride": "innerHTML" }
        ]
      }'
    >
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <script src="/focus.js" defer></script>
  </head>
  <body
    hx-on::send-error="document.querySelector('#status').textContent = 'Could not reach the server.'"
    hx-on::timeout="document.querySelector('#status').textContent = 'The server did not answer within five seconds.'"
  >
    <%- include('partials/header') %>
    <main>
      <% if (locals.user) { %>
        <%- include('partials/entry-form') %>
      <% } else { %>
        <p id="login-prompt" class="mb-6"><a href="/login" class="text-teal-700 underline">Log in</a> or <a href="/signup" class="text-teal-700 underline">sign up</a> to add notes.</p>
      <% } %>
      <%- include('partials/status') %>
      <ul id="entries" tabindex="-1">
        <% entries.forEach((entry) => { %>
          <%- include('partials/entry', { entry }) %>
        <% }); %>
      </ul>

      <% if (locals.user) { %>
      <section class="classic-form">
        <h2>Classic form (no JavaScript)</h2>
        <form method="POST" action="/entries/classic">
          <label for="classic-title" class="sr-only">Title</label>
          <input type="text" id="classic-title" name="title" placeholder="Title">
          <label for="classic-body" class="sr-only">Body</label>
          <input type="text" id="classic-body" name="body" placeholder="Body">
          <button type="submit">Add entry the classic way</button>
        </form>
      </section>
      <% } %>
    </main>
  </body>
</html>

<!doctype html>
<% if (events.length == 0) {%>
  <h1>No events</h1>
<% } else { %>
  <%

  const eventsWithDate = events.filter(event => event.hasOwnProperty("date")).sort((a, b) => {
    const date1 = new Date(a.date).getTime();
    const date2 = new Date(b.date).getTime();
    if (date1 > date2) {
      return 1;
    } else if (date1 < date2 ) {
      return -1;
    } else {
      return 0;
    };
  });
  const eventsWithoutDate = events.filter(event => !event.hasOwnProperty("date"));

  %>
  <ul>
<% eventsWithDate.forEach(event => { %>
  <li><%= event.title %></li>
  <li><%= event.date %></li>
<% }); %>
</ul>

<ul>
  <% eventsWithoutDate.forEach(event => { %>
    <li><%= event.title %></li>
  <% }); %>
</ul>
<% } %>
